# Copia este archivo a .env y ajusta los valores. Las variables PUBLIC_* llegan al navegador.

# Origen de la API en Go. También fija `connect-src` de la política de seguridad (CSP) al construir.
PUBLIC_API_URL=http://localhost:8080

# mock = datos simulados en el navegador (sin backend, valor por defecto)
# http = API real (PUBLIC_API_URL): cuenta, dispositivos, enlaces, espacio y sincronización van al servidor
PUBLIC_BACKEND=mock

# cookie = sesión web con cookie HttpOnly (por defecto): el token de renovación nunca toca JS/localStorage
# body   = tokens en el TokenStore (escritorio y móvil; la web antigua)
PUBLIC_SESSION_MODE=cookie
